# Copie para .env (o Git ignora o .env) e preencha. Usado pelo docker compose e pelo backend local.
# Em produção estes valores vêm do AWS SSM Parameter Store (/margemai/prod/*) e não ficam em arquivo.

# Senha do PostgreSQL do docker compose
POSTGRES_PASSWORD=margemai_secure_pass

# Assistente de IA (Claude). Sem chave, o assistente fica desligado e o restante do sistema funciona.
# Crie a chave em https://console.anthropic.com e defina um limite mensal de gasto.
ANTHROPIC_API_KEY=
MARGEMAI_AI_MODEL=claude-sonnet-5-5
MARGEMAI_AI_DAILY_MESSAGE_LIMIT=30
